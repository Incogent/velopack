<!-- Blackbird package-selection dialog based on the WiX standard dialog conventions. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <UI>
            <Dialog Id="PackageOptionsDlg" Width="370" Height="270" Title="[MsiDlgTitle]">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Packages" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose bundles to install when Blackbird first starts." />
                <Control Id="Required" Type="Text" X="20" Y="58" Width="330" Height="20" Text="System Information is always installed for the tutorial." />
                <Control Id="Android" Type="CheckBox" X="20" Y="85" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_ANDROID" CheckBoxValue="1" Text="Android" />
                <Control Id="Godot" Type="CheckBox" X="20" Y="107" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_GODOT" CheckBoxValue="1" Text="Godot" />
                <Control Id="Steam" Type="CheckBox" X="20" Y="129" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_STEAM" CheckBoxValue="1" Text="Steam" />
                <Control Id="Unity" Type="CheckBox" X="20" Y="151" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_UNITY" CheckBoxValue="1" Text="Unity" />
                <Control Id="Unreal" Type="CheckBox" X="20" Y="173" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_UNREAL" CheckBoxValue="1" Text="Unreal" />
                <Control Id="Utilities" Type="CheckBox" X="20" Y="195" Width="330" Height="18" Property="BLACKBIRD_BUNDLE_UTILITIES" CheckBoxValue="1" Text="Utilities" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[MsiBtnBack]" />
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[MsiBtnNext]" />
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[MsiBtnCancel]">
                    <Publish Event="SpawnDialog" Value="CancelDlg" />
                </Control>
            </Dialog>
        </UI>
    </Fragment>
</Wix>
